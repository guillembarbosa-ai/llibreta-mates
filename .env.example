# Local: no cal res; la base de dades és data/aula.db i els fitxers data/uploads/.
# Producció (Vercel): copia aquestes variables al projecte de Vercel.

NODE_ENV=production
SESSION_SECRET=canvia-això-per-una-cadena-llarga-aleatòria

# Turso (base de dades SQLite al núvol). Copia l'URL i el token de `turso db show`.
LIBSQL_URL=libsql://el-teu-nom.turso.io
LIBSQL_AUTH_TOKEN=eyJ...

# Supabase Storage (fitxers pujats). Fes servir la clau service_role.
SUPABASE_URL=https://el-teu-projecte.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_BUCKET=lliuraments
