# Copia aquest fitxer a .env.local i omple-ho amb dades del projecte de Firebase:
# Firebase Console → Project Settings → General → Your apps → Web app
#
# Per veure-ho al teu equip sense crear encara el projecte:
#   VITE_LOCAL_DEMO=true
# Quan tinguis el projecte de Firebase: VITE_LOCAL_DEMO=false i omple la resta.
# NO despleguis mai amb VITE_LOCAL_DEMO=true.

VITE_LOCAL_DEMO=false
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=aula-dia-a-dia.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=aula-dia-a-dia
VITE_FIREBASE_STORAGE_BUCKET=aula-dia-a-dia.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
